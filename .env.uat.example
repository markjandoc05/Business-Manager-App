# Local authenticated browser UAT only. Copy to a local environment file; do not
# use this configuration for production or deploy it.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_LOCAL_UAT=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-bsm-client-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-bsm-client-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-bsm-client-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:bsmuat
GOOGLE_CLOUD_PROJECT=demo-bsm-client-app
GCLOUD_PROJECT=demo-bsm-client-app
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199
# Browser Firebase SDK endpoints. The local UAT runner may replace these with
# dynamically allocated ports when a standard emulator port is occupied.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Set true to exercise the trusted local Platform provisioning path. False
# disables new onboarding; it never restores browser Firestore provisioning.
NEXT_PUBLIC_ENABLE_PLATFORM_ONBOARDING=false
NEXT_PUBLIC_ENABLE_PLATFORM_SUBSCRIPTION_MOCK=false
# Local trusted Platform API for isolated UAT. This value is server-only.
VENTALE_PLATFORM_API_BASE_URL=http://localhost:3001

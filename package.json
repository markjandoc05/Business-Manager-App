  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:auth": "node --experimental-strip-types --test tests/auth/sign-in-controller.test.mjs",
    "test:indexes": "node scripts/validate-firestore-indexes.mjs",
    "test:followups": "node --experimental-strip-types --test tests/follow-up-utils.test.mjs",
    "test:feedback-email": "node --experimental-strip-types --test tests/feedback-email.test.mjs",
    "test:project-identity": "node --experimental-strip-types --test tests/project-identity.test.mjs",
    "test:script-safety": "node --test tests/scripts/privileged-script-safety.test.mjs",
    "clean": "next clean",
  "test:rules": "firebase emulators:exec --project demo-bsm-client-app --only firestore \"node --test tests/firestore/application-user.rules.test.mjs && node --test tests/firestore/lead-conversion.rules.test.mjs && node --test tests/firestore/workspace-onboarding.rules.test.mjs && node --test tests/firestore/licensing.rules.test.mjs && node --test tests/firestore/settings.rules.test.mjs && node --test tests/firestore/client-child-lifecycle.rules.test.mjs && node --test tests/firestore/record-lifecycle.rules.test.mjs && node --test tests/firestore/deal-task-authorization.rules.test.mjs && node --test tests/firestore/deal-closure.rules.test.mjs && node --test tests/firestore/beta-gate-a.rules.test.mjs && node --test tests/firestore/platform-console-read.rules.test.mjs && node --test tests/firestore/feedback.rules.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --project demo-bsm-client-app --only firestore,storage \"node --test tests/storage/client-documents.rules.test.mjs\"",
    "test:membership-api": "firebase emulators:exec --project demo-bsm-client-app --only auth,firestore \"node --test tests/api/membership-route.integration.test.mjs\"",
    "test:client-document-delete-api": "firebase emulators:exec --project demo-bsm-client-app --only auth,firestore,storage \"node --test tests/api/client-document-delete-route.integration.test.mjs\"",
    "test:client-note-delete-api": "firebase emulators:exec --project demo-bsm-client-app --only auth,firestore \"node --test tests/api/client-note-delete-route.integration.test.mjs\""
  },

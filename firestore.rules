        && request.resource.data.keys().hasOnly(['name', 'company', 'email', 'phone', 'source', 'status', 'assignedTo', 'assignedToUid', 'assignedToName', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'archived', 'archivedAt', 'archivedBy', 'trashed', 'trashedAt', 'trashedBy', 'convertedClientId', 'nextScheduledActivityAt', 'nextScheduledActivityType', 'nextScheduledActivityId', 'lastActivityAt', 'lastActivityType'])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.assignedToUid is string
        && (!request.resource.data.keys().hasAny(['trashed']) || request.resource.data.trashed is bool)
        && (!request.resource.data.keys().hasAny(['trashed']) || request.resource.data.trashed != true
          || (request.resource.data.archived == true
            && request.resource.data.trashedAt is timestamp
            && request.resource.data.trashedBy == request.auth.uid))
        && organizationCanAssign(organizationId, request.resource.data.assignedToUid)
        && (!request.resource.data.keys().hasAny(['nextScheduledActivityAt']) || request.resource.data.nextScheduledActivityAt == null || request.resource.data.nextScheduledActivityAt is timestamp)

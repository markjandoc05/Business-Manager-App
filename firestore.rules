      allow create: if organizationCanWrite(organizationId)
        && (exists(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId))
          || getAfter(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId)).data.keys().hasAny(['name']))
        && request.resource.data.keys().hasOnly(['entryType', 'activityType', 'activityStatus', 'content', 'occurredAt', 'createdAt', 'createdByUid', 'createdByName'])
        && request.resource.data.entryType in ['ACTIVITY', 'NOTE', 'SYSTEM']
        && request.resource.data.content is string
        && request.resource.data.content != ''
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByName is string

            && (resource.data.status == 'Won' ? request.resource.data.wonAt == resource.data.wonAt : request.resource.data.wonAt == request.time)
            && (!request.resource.data.keys().hasAny(['lossReason']) || request.resource.data.lossReason == null))
          || (request.resource.data.status == 'Lost' && request.resource.data.stage == 'Lost'

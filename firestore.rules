rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Console access is deliberately separate from organization membership.
    // Only active SUPER_ADMIN and SUPPORT records can read cross-tenant
    // platform data; all privileged mutations remain Admin SDK-only.
    function isActivePlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.status == 'ACTIVE'
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'SUPPORT'];
    }

    function isSuperAdmin() {
      return isActivePlatformAdmin()
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    function isOrganizationMember(organizationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role in ['ADMIN', 'MANAGER', 'USER'];
    }

    function isOrganizationAdmin(organizationId) {
      return isOrganizationMember(organizationId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isBootstrapOrganizationCreate(organizationId) {
      return signedIn()
        && !exists(/databases/$(database)/documents/organizations/$(organizationId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.createdByUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'ADMIN'
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/workspaceBootstrap/$(request.auth.uid)).data.organizationId == organizationId
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/settings/settings).data.businessName is string
        && getAfter(/databases/$(database)/documents/organizationSlugs/$(getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.slug)).data.organizationId == organizationId;
    }

    function organizationCanView(organizationId) {
      return isOrganizationMember(organizationId)
        && exists(/databases/$(database)/documents/organizations/$(organizationId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)).data.status in ['trial', 'active', 'expired', 'suspended'];
    }

    // The organization mirror is intentionally small so every business write
    // can enforce licensing without an additional license-document lookup.
    function licenseAllowsWrites(organizationId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)).data.licenseWriteEnabled == true
        && get(/databases/$(database)/documents/organizations/$(organizationId)).data.licenseStatus in ['TRIAL', 'ACTIVE']
        && (!get(/databases/$(database)/documents/organizations/$(organizationId)).data.keys().hasAny(['licenseExpiresAt'])
          || get(/databases/$(database)/documents/organizations/$(organizationId)).data.licenseExpiresAt == null
          || request.time <= get(/databases/$(database)/documents/organizations/$(organizationId)).data.licenseExpiresAt);
    }

    // Settings mutations additionally verify the canonical license. This keeps
    // browser writes fail-closed if a mirror is stale, missing, or malformed.
    function settingsLicenseAllowsWrites(organizationId) {
      return licenseAllowsWrites(organizationId)
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/license/current)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.plan in ['TRIAL', 'STARTER', 'TEAM', 'LEGACY']
        && get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.maxUsers is int
        && get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.maxUsers >= 1
        && get(/databases/$(database)/documents/organizations/$(organizationId)).data.licenseStatus == get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.status
        && ((get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.status == 'TRIAL'
          && get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.trialStartedAt is timestamp
          && get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.trialEndsAt is timestamp
          && request.time <= get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.trialEndsAt
          && get(/databases/$(database)/documents/organizations/$(organizationId)).data.licenseExpiresAt == get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.trialEndsAt)
          || (get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.status == 'ACTIVE'
            && get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.subscriptionStartedAt is timestamp
            && get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.subscriptionEndsAt is timestamp
            && request.time <= get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.subscriptionEndsAt
            && get(/databases/$(database)/documents/organizations/$(organizationId)).data.licenseExpiresAt == get(/databases/$(database)/documents/organizations/$(organizationId)/license/current).data.subscriptionEndsAt));
    }

    function organizationCanWrite(organizationId) {
      return organizationCanView(organizationId) && licenseAllowsWrites(organizationId);
    }

    function organizationCanManageWrite(organizationId) {
      return organizationCanManage(organizationId) && licenseAllowsWrites(organizationId);
    }

    function organizationCanManage(organizationId) {
      return organizationCanView(organizationId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role in ['ADMIN', 'MANAGER'];
    }

    function organizationCanCreateTask(organizationId) {
      return organizationCanManageWrite(organizationId)
        || (organizationCanWrite(organizationId)
          && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'USER'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.assignedToUid == request.auth.uid);
    }

    function organizationCanAssign(organizationId, userId) {
      return organizationCanView(organizationId)
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(userId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(userId)).data.status == 'active'
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(userId)).data.role in ['ADMIN', 'MANAGER', 'USER']
        && (userId == request.auth.uid || organizationCanManage(organizationId));
    }

    function organizationCanUpdateDeal(organizationId) {
      return organizationCanManage(organizationId)
        || (organizationCanView(organizationId)
          && resource.data.assignedToUid == request.auth.uid
          && request.resource.data.assignedToUid == resource.data.assignedToUid);
    }

    function organizationCanViewDeal(organizationId) {
      return organizationCanManage(organizationId)
        || (organizationCanView(organizationId) && resource.data.assignedToUid == request.auth.uid);
    }

    function organizationCanViewTask(organizationId) {
      return organizationCanManage(organizationId)
        || (organizationCanView(organizationId) && resource.data.assignedToUid == request.auth.uid);
    }

    function organizationRelatedRecordExists(organizationId, relatedTo) {
      return relatedTo.type == 'Lead'
        ? exists(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(relatedTo.id))
          && get(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(relatedTo.id)).data.archived != true
        : relatedTo.type == 'Client'
          ? exists(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(relatedTo.id))
            && get(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(relatedTo.id)).data.status != 'ARCHIVED'
          : relatedTo.type == 'Deal'
            ? exists(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(relatedTo.id))
              && get(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(relatedTo.id)).data.archived != true
            : false;
    }

    function organizationTaskCanManage(organizationId) {
      return organizationCanManage(organizationId)
        || (organizationCanView(organizationId)
          && resource.data.assignedToUid == request.auth.uid
          && request.resource.data.assignedToUid == resource.data.assignedToUid);
    }

    // System activities are only valid when their related mutation is part of the
    // same atomic batch/transaction. This prevents clients from writing fabricated
    // audit history directly to the activities collection.
    function activityCreatesLead(organizationId, leadId) {
      return !exists(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId)).data.createdBy == request.auth.uid;
    }

    function activityCreatesClient(organizationId, clientId) {
      return !exists(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)).data.createdBy == request.auth.uid;
    }

    function activityUpdatesClient(organizationId, clientId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)).data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)).data.updatedAt == request.time;
    }

    function activityArchivesClient(organizationId, clientId) {
      return activityUpdatesClient(organizationId, clientId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)).data.status != 'ARCHIVED'
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)).data.status == 'ARCHIVED';
    }

    function activityRestoresClient(organizationId, clientId) {
      return activityUpdatesClient(organizationId, clientId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)).data.status == 'ARCHIVED'
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)).data.status == 'ACTIVE';
    }

    function activityConvertsLead(organizationId, leadId, clientId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId)).data.status != 'Client'
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId)).data.status == 'Client'
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/leads/$(leadId)).data.convertedClientId == clientId
        && !exists(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)).data.sourceLeadId == leadId;
    }

    function activityCreatesDeal(organizationId, dealId) {
      return !exists(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.createdBy == request.auth.uid;
    }

    function activityUpdatesDeal(organizationId, dealId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.updatedAt == request.time;
    }

    function activityChangesDealStage(organizationId, dealId) {
      return activityUpdatesDeal(organizationId, dealId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.stage != getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.stage;
    }

    function activityWinsDeal(organizationId, dealId) {
      return activityChangesDealStage(organizationId, dealId)
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.status == 'Won';
    }

    function activityLosesDeal(organizationId, dealId) {
      return activityChangesDealStage(organizationId, dealId)
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.status == 'Lost';
    }

    function activityReopensDeal(organizationId, dealId) {
      return activityChangesDealStage(organizationId, dealId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.status in ['Won', 'Lost']
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.status == 'Active';
    }

    function activityArchivesDeal(organizationId, dealId) {
      return activityUpdatesDeal(organizationId, dealId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.archived != true
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.archived == true;
    }

    function activityRestoresDeal(organizationId, dealId) {
      return activityUpdatesDeal(organizationId, dealId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.archived == true
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(dealId)).data.archived == false;
    }

    function activityCreatesTask(organizationId, taskId) {
      return !exists(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.createdBy == request.auth.uid;
    }

    function activityUpdatesTask(organizationId, taskId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.updatedAt == request.time;
    }

    function activityCompletesTask(organizationId, taskId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.status != 'Completed'
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.status == 'Completed'
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.updatedAt == request.time;
    }

    function activityReopensTask(organizationId, taskId) {
      return activityUpdatesTask(organizationId, taskId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.status == 'Completed'
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.status == 'Pending';
    }

    function activityArchivesTask(organizationId, taskId) {
      return activityUpdatesTask(organizationId, taskId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.archived != true
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.archived == true;
    }

    function activityRestoresTask(organizationId, taskId) {
      return activityUpdatesTask(organizationId, taskId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.archived == true
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/tasks/$(taskId)).data.archived == false;
    }

    function activityCreatesNote(organizationId, clientId, noteId) {
      return !exists(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId)).data.createdByUid == request.auth.uid;
    }

    function activityUpdatesNote(organizationId, clientId, noteId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId))
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId)).data.content != get(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId)).data.content;
    }

    function activityArchivesNote(organizationId, clientId, noteId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId)).data.archived != true
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId)).data.archived == true;
    }

    function activityRestoresNote(organizationId, clientId, noteId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId)).data.archived == true
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)/notes/$(noteId)).data.archived == false;
    }

    function activityUpdatesSettings(organizationId) {
      return getAfter(/databases/$(database)/documents/organizations/$(organizationId)/settings/settings).data.businessName is string
        && (!exists(/databases/$(database)/documents/organizations/$(organizationId)/settings/settings)
          || getAfter(/databases/$(database)/documents/organizations/$(organizationId)/settings/settings).data.diff(get(/databases/$(database)/documents/organizations/$(organizationId)/settings/settings).data).affectedKeys().size() > 0);
    }

    match /users/{userId} {
      // Global profiles are identity records, not an organization directory.
      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'USER'
        && request.resource.data.active == false
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'displayName', 'photoURL', 'status', 'role', 'active', 'createdAt', 'lastLogin', 'lastLoginAt']);

      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'name', 'email', 'displayName', 'photoURL', 'status', 'lastLogin', 'lastLoginAt'])
        && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == userId)
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['pending', 'active', 'disabled']);

      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if isActivePlatformAdmin()
        || isOrganizationMember(organizationId);
      allow create: if isBootstrapOrganizationCreate(organizationId)
        && request.resource.data.keys().hasOnly(['name', 'slug', 'businessType', 'status', 'plan', 'subscriptionStatus', 'maxUsers', 'licenseStatus', 'licenseWriteEnabled', 'licenseExpiresAt', 'createdAt', 'updatedAt', 'createdByUid'])
        && request.resource.data.name is string
        && request.resource.data.slug is string
        && request.resource.data.status == 'trial'
        && request.resource.data.plan == 'trial'
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.maxUsers == 3
        && request.resource.data.licenseStatus == 'TRIAL'
        && request.resource.data.licenseWriteEnabled == true
        && request.resource.data.licenseExpiresAt is timestamp
        && request.resource.data.createdByUid == request.auth.uid;
      // Organization and license mirror mutations are Console server API work.
      allow update: if false;
      allow delete: if false;
    }

    match /organizations/{organizationId}/members/{userId} {
      allow read: if isActivePlatformAdmin()
        || (signedIn() && userId == request.auth.uid && resource.data.status == 'active')
        || isOrganizationMember(organizationId);
      allow create: if isBootstrapOrganizationCreate(organizationId)
        && request.resource.data.keys().hasOnly(['userId', 'email', 'displayName', 'role', 'status', 'joinedAt', 'activatedAt', 'activatedBy'])
        && request.resource.data.userId == userId
        && request.resource.data.role in ['ADMIN', 'MANAGER', 'USER']
        && request.resource.data.status in ['pending', 'active', 'inactive', 'suspended', 'archived']
        && (isBootstrapOrganizationCreate(organizationId)
          ? (userId == request.auth.uid && request.resource.data.role == 'ADMIN' && request.resource.data.status == 'active')
          : true);
      // Existing memberships are changed only through the authenticated server
      // handler, which counts active members inside an Admin SDK transaction.
      allow update, delete: if false;
    }

    // Feedback is written by the authenticated server endpoint so it can
    // safely enrich submissions and record email delivery status. Browser
    // clients have no direct read, update, or delete access.
    match /organizations/{organizationId}/feedback/{feedbackId} {
      allow read, write: if false;
    }

    match /organizations/{organizationId}/license/{licenseId} {
      allow read: if licenseId == 'current' && organizationCanView(organizationId);
      allow create: if licenseId == 'current'
        && isBootstrapOrganizationCreate(organizationId)
        && !exists(/databases/$(database)/documents/organizations/$(organizationId)/license/current)
        && request.resource.data.keys().hasOnly(['plan', 'status', 'trialStartedAt', 'trialEndsAt', 'maxUsers', 'features', 'createdAt', 'updatedAt', 'updatedBy'])
        && request.resource.data.plan == 'TRIAL'
        && request.resource.data.status == 'TRIAL'
        && request.resource.data.trialStartedAt is timestamp
        && request.resource.data.trialEndsAt is timestamp
        && request.resource.data.trialEndsAt >= request.time
        && request.resource.data.trialEndsAt <= request.time + duration.value(14, 'd')
        && request.resource.data.maxUsers == 3
        && request.resource.data.features is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.uid;
      // License documents are created during onboarding and mutated only by
      // the privileged Console server API (Firebase Admin SDK).
      allow update: if false;
      allow delete: if false;
    }

    // Collection-group workspace discovery is limited to the caller's own active,
    // valid-role membership. This grants no write access and does not expose a directory.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['pending', 'active', 'inactive', 'suspended', 'archived']
        && resource.data.role in ['ADMIN', 'MANAGER', 'USER'];
      allow write: if false;
    }

    match /organizationSlugs/{slug} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/organizationSlugs/$(slug))
        && request.resource.data.keys().hasOnly(['organizationId', 'slug', 'createdAt', 'createdByUid'])
        && request.resource.data.organizationId is string
        && request.resource.data.slug == slug
        && request.resource.data.createdByUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.createdByUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/members/$(request.auth.uid)).data.role == 'ADMIN'
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/members/$(request.auth.uid)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/workspaceBootstrap/$(request.auth.uid)).data.organizationId == request.resource.data.organizationId
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/settings/settings).data.businessName is string;
      allow update, delete: if false;
    }

    match /workspaceBootstrap/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn()
        && userId == request.auth.uid
        && !exists(/databases/$(database)/documents/workspaceBootstrap/$(userId))
        && request.resource.data.keys().hasOnly(['organizationId', 'createdAt', 'createdByUid'])
        && request.resource.data.organizationId is string
        && request.resource.data.createdByUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.createdByUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/members/$(request.auth.uid)).data.role == 'ADMIN'
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/members/$(request.auth.uid)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/settings/settings).data.businessName is string;
      allow update, delete: if false;
    }

    match /platformUsers/{userId} {
      // Replaced by platformAdmins. Retained solely to make the legacy path
      // explicitly inaccessible to browser clients.
      allow read, write: if false;
    }

    // Platform administration is intentionally read-only from browser SDKs.
    // The Console uses its server-side Firebase Admin SDK for all mutations.
    match /platformAdmins/{adminId} {
      // The browser needs only its own record to establish Console access.
      // Platform-admin directory reads are served by the Console's Admin SDK.
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /platformAuditLogs/{logId} {
      allow read: if isActivePlatformAdmin();
      allow write: if false;
    }

    match /organizations/{organizationId}/clients/{clientId} {

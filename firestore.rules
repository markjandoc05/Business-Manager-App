        && request.resource.data.storagePath is string
        && request.resource.data.downloadURL is string
        && request.resource.data.mimeType is string
        && request.resource.data.size is number
        && request.resource.data.uploadedAt is timestamp
        && request.resource.data.uploadedByUid == request.auth.uid
        && request.resource.data.uploadedByName is string
        && request.resource.data.archived == false
        && request.resource.data.archivedAt == null
        && request.resource.data.archivedBy == null
        && request.resource.data.size > 0
        && request.resource.data.size <= 1048576
        && request.resource.data.mimeType in ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', 'image/jpeg', 'image/png']
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId))

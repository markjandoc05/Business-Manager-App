        && request.resource.data.keys().hasOnly(['title', 'clientId', 'leadId', 'value', 'stage', 'status', 'expectedCloseDate', 'productServiceName', 'notes', 'assignedTo', 'assignedToUid', 'assignedToName', 'lossReason', 'wonAt', 'lostAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'archived', 'archivedAt', 'archivedBy'])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.leadId == resource.data.leadId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.assignedToUid is string
        && request.resource.data.assignedToName is string

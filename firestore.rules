        && (!request.resource.data.keys().hasAny(['nextScheduledActivityId']) || request.resource.data.nextScheduledActivityId == null || request.resource.data.nextScheduledActivityId is string)
        && (!request.resource.data.keys().hasAny(['lastActivityAt']) || request.resource.data.lastActivityAt == null || request.resource.data.lastActivityAt is timestamp)
        && (!request.resource.data.keys().hasAny(['lastActivityType']) || request.resource.data.lastActivityType == null || request.resource.data.lastActivityType in ['Call', 'Email', 'Meeting', 'Follow-up', 'Message', 'Other'])
        && (resource.data.status == 'Client'
          ? request.resource.data.status == 'Client'

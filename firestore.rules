        && request.resource.data.keys().hasOnly(['name', 'company', 'email', 'phone', 'assignedTo', 'assignedToUid', 'assignedToName', 'status', 'archived', 'archivedAt', 'archivedBy', 'trashed', 'trashedAt', 'trashedBy', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'sourceLeadId'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.archived == false
        && (!request.resource.data.keys().hasAny(['trashed']) || request.resource.data.trashed == false)
        && request.resource.data.assignedToUid is string
        && organizationCanAssign(organizationId, request.resource.data.assignedToUid)
        && request.resource.data.assignedToName is string;
      allow update: if organizationCanManageWrite(organizationId)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy

            && request.resource.data.keys().hasAll(['metadata'])
            && request.resource.data.metadata.clientId is string
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(request.resource.data.entityId)).data.clientId == request.resource.data.metadata.clientId
            && activityReopensDeal(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'deal_archive'
            && request.resource.data.entityType == 'Deal'
            && request.resource.data.entityId is string
            && request.resource.data.keys().hasAll(['metadata'])
            && request.resource.data.metadata.clientId is string
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(request.resource.data.entityId)).data.clientId == request.resource.data.metadata.clientId
            && activityArchivesDeal(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'deal_restore'
            && request.resource.data.entityType == 'Deal'
            && request.resource.data.entityId is string
            && request.resource.data.keys().hasAll(['metadata'])
            && request.resource.data.metadata.clientId is string
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(request.resource.data.entityId)).data.clientId == request.resource.data.metadata.clientId
            && activityRestoresDeal(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'task_creation'
            && request.resource.data.entityType == 'Task'
            && request.resource.data.entityId is string
            && activityCreatesTask(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'task_update'
            && request.resource.data.entityType == 'Task'
            && request.resource.data.entityId is string
            && activityUpdatesTask(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'task_completion'
            && request.resource.data.entityType == 'Task'
            && request.resource.data.entityId is string
            && activityCompletesTask(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'task_reopened'
            && request.resource.data.entityType == 'Task'
            && request.resource.data.entityId is string
            && activityReopensTask(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'task_archive'
            && request.resource.data.entityType == 'Task'
            && request.resource.data.entityId is string
            && activityArchivesTask(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'task_restore'
            && request.resource.data.entityType == 'Task'
            && request.resource.data.entityId is string
            && activityRestoresTask(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'note_creation'
            && request.resource.data.entityType == 'Note'
            && request.resource.data.entityId is string
            && request.resource.data.keys().hasAll(['metadata'])
            && request.resource.data.metadata.clientId is string
            && request.resource.data.metadata.noteId == request.resource.data.entityId
            && activityCreatesNote(organizationId, request.resource.data.metadata.clientId, request.resource.data.entityId))
          || (request.resource.data.type == 'note_update'
            && request.resource.data.entityType == 'Note'
            && request.resource.data.entityId is string
            && request.resource.data.keys().hasAll(['metadata'])
            && request.resource.data.metadata.clientId is string
            && request.resource.data.metadata.noteId == request.resource.data.entityId
            && activityUpdatesNote(organizationId, request.resource.data.metadata.clientId, request.resource.data.entityId))
          || (request.resource.data.type == 'note_archive'
            && request.resource.data.entityType == 'Note'
            && request.resource.data.entityId is string
            && request.resource.data.keys().hasAll(['metadata'])
            && request.resource.data.metadata.clientId is string
            && request.resource.data.metadata.noteId == request.resource.data.entityId
            && activityArchivesNote(organizationId, request.resource.data.metadata.clientId, request.resource.data.entityId))
          || (request.resource.data.type == 'note_restore'
            && request.resource.data.entityType == 'Note'
            && request.resource.data.entityId is string
            && request.resource.data.keys().hasAll(['metadata'])
            && request.resource.data.metadata.clientId is string
            && request.resource.data.metadata.noteId == request.resource.data.entityId
            && activityRestoresNote(organizationId, request.resource.data.metadata.clientId, request.resource.data.entityId))
          || (request.resource.data.type == 'settings_update'
            && request.resource.data.entityType == 'Settings'
            && !request.resource.data.keys().hasAny(['entityId'])
            && activityUpdatesSettings(organizationId)));
      allow update, delete: if false;
    }

    // The remaining root business collections are historical migration sources only.
    // They stay intact for read-only Admin SDK audit/migration scripts but are never
    // available to browser clients.
    match /deals/{dealId} { allow read, write: if false; }
    match /deals/{dealId}/timeline/{entryId} { allow read, write: if false; }
    match /tasks/{taskId} { allow read, write: if false; }
    match /system/settings { allow read, write: if false; }
    match /activities/{activityId} { allow read, write: if false; }

    // No other Firestore collections are publicly accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

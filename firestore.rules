            && activityCreatesDeal(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'deal_update'
            && request.resource.data.entityType == 'Deal'
            && request.resource.data.entityId is string
            && request.resource.data.keys().hasAll(['metadata'])
            && request.resource.data.metadata.clientId is string
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/deals/$(request.resource.data.entityId)).data.clientId == request.resource.data.metadata.clientId
            && activityUpdatesDeal(organizationId, request.resource.data.entityId))
          || (request.resource.data.type == 'stage_change'
            && request.resource.data.entityType == 'Deal'

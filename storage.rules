rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Client Documents use authenticated server routes. Server authorization
    // preserves live user/member/license/Client checks without Storage's two
    // Firestore-document limit. No new token download URLs are created.
    // Existing objects/tokens are untouched; historical token links remain valid.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
